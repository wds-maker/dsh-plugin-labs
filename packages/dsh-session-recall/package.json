    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "memory",
    "recap",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wds-maker/dsh-plugin-labs.git",
    "directory": "packages/dsh-session-recall"
  },
  "bugs": {
    "url": "https://github.com/wds-maker/dsh-plugin-labs/issues"
  },
  "homepage": "https://github.com/wds-maker/dsh-plugin-labs/tree/main/packages/dsh-session-recall#readme",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
