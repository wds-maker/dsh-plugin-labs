{
  "name": "dsh-comfyui-autostart",
  "version": "0.1.2",
  "private": true,
  "description": "Start the local ComfyUI server automatically when DSH boots, so image generation works without a manual launch.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "test:integration": "node integration/autostart.integration.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "comfyui",
    "autostart",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wds-maker/dsh-plugin-labs.git",
    "directory": "packages/dsh-comfyui-autostart"
  },
  "bugs": {
    "url": "https://github.com/wds-maker/dsh-plugin-labs/issues"
  },
  "homepage": "https://github.com/wds-maker/dsh-plugin-labs/tree/main/packages/dsh-comfyui-autostart#readme",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
